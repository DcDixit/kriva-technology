# Inquiry delivery (never commit real secrets).
# Contact-form leads go to hello@krivatechnologies.com (shared/studio.js CONTACT_EMAIL).
INQUIRY_TO=hello@krivatechnologies.com

# SMTP login for the hello@ mailbox (Google Workspace or equivalent).
# Override GMAIL_USER in Vercel env if the SMTP account differs.
GMAIL_USER=hello@krivatechnologies.com
GMAIL_APP_PASSWORD=

# Optional instead of Gmail:
# RESEND_API_KEY=
# RESEND_FROM=KRIVA <onboarding@resend.dev>
#
# Optional FormSubmit alternative (key is designed to be public):
# WEB3FORMS_ACCESS_KEY=
#
# If none of the above are set, the contact page delivers via a FormSubmit
# HTML POST (not the AJAX API — those confirmation links 404).
