# Inquiry delivery (never commit real secrets).
# Public contact address: hello@krivatechnologies.com (shared/studio.js CONTACT_EMAIL).
INQUIRY_TO=hello@krivatechnologies.com

# Backend-only CC for form notification emails (never expose in frontend).
INQUIRY_CC=your-private-cc@example.com

# Gmail SMTP, this is the production send path on Vercel.
# GMAIL_APP_PASSWORD must be a Google App Password: exactly 16 letters
# (spaces are optional and stripped). A normal Gmail password will not work.
# Google Account for GMAIL_USER → Security → 2-Step Verification → App passwords.
GMAIL_USER=krivatechnlogies@gmail.com
GMAIL_APP_PASSWORD=

# Backup channel. Web3Forms' free plan accepts browser submissions only, so /api/inquiry returns this
# key to the browser only when server delivery fails. It is a public, inbox-scoped key, but keep it in
# Vercel env so it stays out of Git. Get one at web3forms.com using hello@krivatechnologies.com.
WEB3FORMS_ACCESS_KEY=
# If every channel fails, the form shows a pre-filled mailto link to hello@krivatechnologies.com.
#
# For local preview: copy to .env.local and set GMAIL_APP_PASSWORD there.
# After changing Vercel env vars, redeploy so the inquiry function picks them up.
