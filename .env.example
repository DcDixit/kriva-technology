# Inquiry delivery (never commit real secrets).
# Public contact address: hello@krivatechnologies.com (shared/studio.js CONTACT_EMAIL).
INQUIRY_TO=hello@krivatechnologies.com

# Backend-only CC for form notification emails (never expose in frontend).
INQUIRY_CC=dixit27592@gmail.com

# SMTP login for outbound mail (may differ from INQUIRY_TO).
# Set GMAIL_APP_PASSWORD in Vercel (Google Account → Security → App passwords).
GMAIL_USER=krivatechnlogies@gmail.com
GMAIL_APP_PASSWORD=

# Optional instead of Gmail:
# RESEND_API_KEY=
# RESEND_FROM=KRIVA <hello@krivatechnologies.com>
#
# Optional FormSubmit alternative (key is designed to be public):
# WEB3FORMS_ACCESS_KEY=
#
# If none of the above are set, the contact page delivers via a FormSubmit
# HTML POST (not the AJAX API — those confirmation links 404).
# Note: INQUIRY_CC applies only to server-side delivery (Gmail SMTP or Resend).
