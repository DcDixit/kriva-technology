# Inquiry delivery (never commit real secrets).
# Contact-form leads always go to krivatechnlogies@gmail.com (hardcoded in api/inquiry.js).
INQUIRY_TO=krivatechnlogies@gmail.com

# Recommended on Vercel: Gmail App Password for that inbox
# (Google Account → Security → 2-Step Verification → App passwords)
GMAIL_USER=krivatechnlogies@gmail.com
GMAIL_APP_PASSWORD=

# Optional instead of Gmail:
# RESEND_API_KEY=
# RESEND_FROM=KRIVA <onboarding@resend.dev>
#
# Optional FormSubmit alternative (key is designed to be public):
# WEB3FORMS_ACCESS_KEY=
#
# If none of the above are set, the contact page delivers via a FormSubmit
# HTML POST (not the AJAX API — those confirmation links 404).
